# 10kt.com — front controller routing
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host (the login cookie lives on 10kt.com only)
RewriteCond %{HTTP_HOST} ^www\.10kt\.com$ [NC]
RewriteRule ^ https://10kt.com%{REQUEST_URI} [R=301,L]

# Old URLs -> new user-scoped URLs
RewriteRule ^40c3/?$ /rafeh/40c3/ [R=301,L]

# Never serve app internals
RewriteRule ^app(/|$) - [F,L]

# Real files and folders (calidroid1500/, audio-tracker/, images...) are served as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else -> router
RewriteRule ^ index.php [L,QSA]
</IfModule>
